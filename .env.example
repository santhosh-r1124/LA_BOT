# =============================================================================
# legal-platform — root environment file
# -----------------------------------------------------------------------------
# Copy to `.env` for local development:  cp .env.example .env
# This file is consumed by docker compose and is the single source of truth for
# infrastructure + cross-service values. App-specific overrides live in
# apps/*/.env.example.
#
# Environments:
#   development -> this file, Docker Compose Postgres + Redis (default)
#   staging     -> infrastructure/deployment/staging.env.example    (Supabase)
#   production  -> infrastructure/deployment/production.env.example  (Supabase)
#
# VERCEL DEPLOYMENT:
#   For free deployment on Vercel with Google Gemini:
#   1. Set LLM_PROVIDER=gemini
#   2. Add GEMINI_API_KEY in Vercel dashboard (Settings → Environment Variables)
#   3. Get free key at: https://aistudio.google.com/apikey
#   See DEPLOYMENT.md for full guide.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=DEBUG                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                  # console (dev) | json (staging/prod)

# ---- Ports (host) ----------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
ADVOCATE_PORTAL_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- PostgreSQL (Docker Compose service `postgres`) -------------------------
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal_dev_password
POSTGRES_DB=legal_platform

# Async driver URL used by the FastAPI app (asyncpg).
DATABASE_URL=postgresql+asyncpg://legal:legal_dev_password@postgres:5432/legal_platform
# Sync driver URL used by Alembic migrations (psycopg).
DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev_password@postgres:5432/legal_platform

# When running the API on the host (uv run ...) instead of inside Compose,
# swap `postgres` -> `localhost` and `redis` -> `localhost`:
#   DATABASE_URL=postgresql+asyncpg://legal:legal_dev_password@localhost:5432/legal_platform
#   DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev_password@localhost:5432/legal_platform
#   REDIS_URL=redis://localhost:6379/0

# ---- Redis (Docker Compose service `redis`) --------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-dev-only-not-a-real-secret
JWT_SECRET=change-me-dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# Demo mode: any email (or name) and any password signs in as a consumer.
# Advocate/admin accounts still need their real password. false = normal login.
OPEN_LOGIN=true
# When set, this ADMIN account is created/kept on startup; it can upload
# advocate CSVs at /advocates/import.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Advocate directory --------------------------------------------------
# CSV imported (added/updated, never deleted) on every API start. Relative to
# apps/api. Empty disables it.
ADVOCATES_CSV_PATH=data/advocates.csv

# ---- CORS ----------------------------------------------------------------
# Comma-separated list of allowed browser origins for the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- AI model provider (chat answers, classification, drafts) ---------------
# All options below except Anthropic have a usable free tier or are free.
# Full details, limits and failure behaviour: docs/api-inventory.md
#
# auto = first configured of: gemini -> groq -> ollama -> anthropic
LLM_PROVIDER=auto
# Answer from general knowledge (labelled "General information") when no
# indexed official source matches. false = strict sources-only replies.
ALLOW_GENERAL_ANSWERS=true

# Google AI Studio (free tier, no billing account). ONE key powers both the
# chat model and the knowledge-base embeddings below.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-flash-latest

# GroqCloud (free plan). Optional alternative/fallback chat provider.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local, free, no key). Install from https://ollama.com, then
#   ollama pull llama3.1:8b
# Host:   http://localhost:11434/v1
# Docker: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# Anthropic Claude (PAID, optional). LLM_MODEL applies to this provider only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Requests per minute per client on AI endpoints (protects free-tier quota).
# 0 disables.
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Embeddings / knowledge base (Phase 3+) --------------------------------
# Uses GEMINI_API_KEY above. Load official sources with: pnpm kb:seed
EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- Legal corpus from Hugging Face ----------------------------------------
# Real Indian court judgments read from a Hugging Face dataset into the
# knowledge base. Nothing is downloaded whole: rows are read a page at a time.
# Manual run:  cd apps/api && uv run python -m app.scripts.ingest_hf_dataset --inspect
# Read token (only needed for gated/private datasets): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_DATASET_NAME=Sumitedu/indian-case-laws
# Viewer split (empty = train). HF_DATASET_FILE reads one parquet/.jsonl file of
# the repo directly (empty = automatic).
HF_DATASET_SPLIT=
HF_DATASET_FILE=
# Documents to keep indexed, and rows fetched per request.
HF_MAX_DOCUMENTS=200
HF_BATCH_SIZE=20
# On API start: ingest up to HF_MAX_DOCUMENTS in the background, then embed new
# chunks with GEMINI_API_KEY (keyword search works without embeddings).
LEGAL_CORPUS_AUTOLOAD=true
LEGAL_CORPUS_EMBED_ON_START=true

# ---- Frontend (Next.js) -------------------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Base URL the API uses to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=http://localhost:3000
