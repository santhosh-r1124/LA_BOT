# =============================================================================
# legal-platform — root environment file
# -----------------------------------------------------------------------------
# Copy to `.env` for local development:  cp .env.example .env
# This file is consumed by docker compose and is the single source of truth for
# infrastructure + cross-service values. App-specific overrides live in
# apps/*/.env.example.
#
# Environments:
#   development -> this file, Docker Compose Postgres + Redis (default)
#   staging     -> infrastructure/deployment/staging.env.example    (Supabase)
#   production  -> infrastructure/deployment/production.env.example  (Supabase)
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=DEBUG                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                  # console (dev) | json (staging/prod)

# ---- Ports (host) ----------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
ADVOCATE_PORTAL_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- PostgreSQL (Docker Compose service `postgres`) -------------------------
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal_dev_password
POSTGRES_DB=legal_platform

# Async driver URL used by the FastAPI app (asyncpg).
DATABASE_URL=postgresql+asyncpg://legal:legal_dev_password@postgres:5432/legal_platform
# Sync driver URL used by Alembic migrations (psycopg).
DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev_password@postgres:5432/legal_platform

# When running the API on the host (uv run ...) instead of inside Compose,
# swap `postgres` -> `localhost` and `redis` -> `localhost`:
#   DATABASE_URL=postgresql+asyncpg://legal:legal_dev_password@localhost:5432/legal_platform
#   DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev_password@localhost:5432/legal_platform
#   REDIS_URL=redis://localhost:6379/0

# ---- Redis (Docker Compose service `redis`) --------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-dev-only-not-a-real-secret
JWT_SECRET=change-me-dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# ---- CORS ----------------------------------------------------------------
# Comma-separated list of allowed browser origins for the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- AI model provider (chat answers, classification, drafts) ---------------
# All options below except Anthropic have a usable free tier or are free.
# Full details, limits and failure behaviour: docs/api-inventory.md
#
# auto = first configured of: gemini -> groq -> ollama -> anthropic
LLM_PROVIDER=auto

# Google AI Studio (free tier, no billing account). ONE key powers both the
# chat model and the knowledge-base embeddings below.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash

# GroqCloud (free plan). Optional alternative/fallback chat provider.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local, free, no key). Install from https://ollama.com, then
#   ollama pull llama3.1:8b
# Host:   http://localhost:11434/v1
# Docker: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# Anthropic Claude (PAID, optional). LLM_MODEL applies to this provider only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Requests per minute per client on AI endpoints (protects free-tier quota).
# 0 disables.
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Embeddings / knowledge base (Phase 3+) --------------------------------
# Uses GEMINI_API_KEY above. Load official sources with: pnpm kb:seed
EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- Dynamic legal-source discovery (docs/adr/0011) ------------------------
# Providers `pnpm kb:discover` runs: curated, india_code_oai, hf_dataset.
# The live ones need outbound access to indiacode.nic.in / huggingface.co.
LEGAL_SOURCE_DISCOVERY_PROVIDERS=curated,india_code_oai,hf_dataset
INDIA_CODE_BASE_URL=https://www.indiacode.nic.in
INDIA_CODE_OAI_PATHS=/oai/request,/server/oai/request
INDIA_CODE_OAI_SET=
HF_DATASET_ID=RUDXLABS/india-central-state-acts
HF_DATASET_MAX_ROWS=2000

# ---- Payments: Razorpay (Phase 10, docs/adr/0012) --------------------------
# Test-mode keys are free: https://dashboard.razorpay.com (Account & Settings
# -> API Keys). Leave empty and checkout returns "payments not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Dashboard -> Webhooks; point it at
#   <API_BASE>/api/v1/payments/webhooks/razorpay
# with events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ---- Frontend (Next.js) -------------------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Base URL the API uses to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=http://localhost:3000
