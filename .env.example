# =============================================================================
# LA_BOT - settings for Docker Compose (this file is OPTIONAL)
# -----------------------------------------------------------------------------
# `docker compose up --build` works with no .env at all: every value below has
# the same default inside docker-compose.yml. Copy this file only to change
# something:
#
#   macOS / Linux : cp .env.example .env
#   Windows       : Copy-Item .env.example .env      (PowerShell)
#
# Windows tips: the file must be named exactly ".env" (not ".env.txt" - turn on
# "File name extensions" in Explorer to check) and saved as UTF-8.
#
# AI KEYS ARE OPTIONAL. With no key the product runs in offline mode: rules-
# based classification, answers built from the retrieved legal passages with
# their sources, template document drafts, and the full advocate directory.
# Adding a key switches on AI-written answers and drafts.
#
# Scope: Docker Compose reads only the variables listed here. Running the API
# natively (uv run ...) reads apps/api/.env instead - see apps/api/.env.example,
# which also lists the settings Compose does not pass on. The frontends read
# apps/web/.env.local and apps/advocate-portal/.env.local when run natively.
#
# This is a local-only setup (there is no hosted deployment). Put real keys in
# .env, which git ignores, never in this example file.
#
# Sections: 1 AI (optional) - 2 Legal library - 3 Sign-in and admin
#           4 Ports - 5 Database - 6 Logging
# =============================================================================


# ---- 1. AI providers (all optional) ------------------------------------------
# Free Google AI Studio key (https://aistudio.google.com/apikey). Turns on AI
# answers and, with EMBEDDING_PROVIDER=gemini, vector search.
GEMINI_API_KEY=
# Free GroqCloud key (https://console.groq.com/keys). Turns on AI answers on its
# own, or backs up Gemini when both are set.
GROQ_API_KEY=

# auto = the first configured of: gemini, groq, ollama, anthropic.
# Or name one: gemini | groq | ollama | anthropic.
LLM_PROVIDER=auto
# Provider to try when the first fails (quota, outage, bad key).
# auto = the other of Gemini/Groq if its key is set; none = never fall back.
LLM_FALLBACK_PROVIDER=auto

# gemini = vector + keyword search (needs GEMINI_API_KEY); none = keyword only.
EMBEDDING_PROVIDER=gemini

GEMINI_LLM_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b

# Optional alternatives. Ollama runs a model on this computer (no key):
#   ollama pull llama3.1:8b
# From inside Docker the host is reachable at http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
# Paid; only if you already have a key.
ANTHROPIC_API_KEY=

# Requests per minute per client on chat and document requests. 0 turns it off.
AI_RATE_LIMIT_PER_MINUTE=20


# ---- 2. Legal library (Hugging Face) ------------------------------------------
# On start the API reads court judgments from this public dataset into the
# database. Needs internet access to huggingface.co, no key. If it cannot
# connect the product still runs; the reason shows in GET /api/v1/status.
LEGAL_CORPUS_AUTOLOAD=true
# Embed the loaded passages for vector search (needs GEMINI_API_KEY).
LEGAL_CORPUS_EMBED_ON_START=true
HF_DATASET_NAME=Sumitedu/indian-case-laws
# Documents to keep indexed, and rows fetched per request.
HF_MAX_DOCUMENTS=200
HF_BATCH_SIZE=20
# Optional: dataset viewer split, or one parquet/.jsonl file of the repo.
HF_DATASET_SPLIT=
HF_DATASET_FILE=
# Read token, only for gated or private datasets.
HF_TOKEN=


# ---- 3. Sign-in and admin ----------------------------------------------------
# Demo sign-in: any email and any password signs in as a consumer (the account
# is created on first use). Advocate and admin accounts still need their real
# password. Set false for normal credential checks.
OPEN_LOGIN=true
# This admin account is created or updated on every API start. It can upload
# advocate CSVs at /advocates/import. Change both if anyone else uses this
# computer.
ADMIN_EMAIL=admin@labot.local
ADMIN_PASSWORD=admin12345
# Signs login tokens. The default only suits a private local machine.
JWT_SECRET=local-only-jwt-secret-change-me-0123456789abcdef


# ---- 4. Ports on this computer -----------------------------------------------
# After changing a web or API port, rebuild: docker compose up --build
# (the website bakes in the API address; CORS follows these ports).
WEB_PORT=3000
ADVOCATE_PORTAL_PORT=3001
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379


# ---- 5. Database (created on first start) ----------------------------------
# Changing these after the first start has no effect on the existing data
# volume. To start over: docker compose down -v
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal_dev_password
POSTGRES_DB=legal_platform


# ---- 6. Logging --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
