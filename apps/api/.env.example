# =============================================================================
# apps/api - settings for running the API on your computer (all OPTIONAL)
# -----------------------------------------------------------------------------
# Copy to apps/api/.env (macOS/Linux: cp .env.example .env, PowerShell:
# Copy-Item .env.example .env), then:
#
#   docker compose up -d db redis        (from the project root)
#   uv sync
#   uv run alembic upgrade head
#   uv run uvicorn app.main:app --reload --port 8000
#
# This file is read ONLY when the API runs natively. Inside Docker Compose the
# API gets its settings from the root .env (see ../../.env.example), which
# covers fewer variables. Settings that Compose does not pass into the
# container are grouped under "Native only" headings below. Windows: the file
# must be named ".env", not ".env.txt".
#
# AI KEYS ARE OPTIONAL. With none set the API runs in offline mode (rules-based
# classification, answers built from the retrieved legal passages with their
# sources, template document drafts). GET /api/v1/status reports llm.mode as
# "offline" or "ai". Put real keys in .env (git ignores it), never here.
#
# Sections: 1 Runtime - 2 Database and Redis - 3 Sign-in, admin, CORS
#           4 Advocate directory - 5 AI providers (optional) - 6 Embeddings
#           7 Legal library (Hugging Face)
# =============================================================================


# ---- 1. Runtime ----------------------------------------------------------------
# development exposes /docs. production hides it and replaces an unset
# JWT_SECRET with a random one per start.
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# console (readable) | json
LOG_FORMAT=console


# ---- 2. Database and Redis ---------------------------------------------------
# Host URLs: "localhost". Inside Docker Compose these are db and redis.
# Async driver (asyncpg) used by the app; sync driver (psycopg) used by Alembic.
DATABASE_URL=postgresql+asyncpg://legal:legal_dev_password@localhost:5432/legal_platform
DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev_password@localhost:5432/legal_platform
REDIS_URL=redis://localhost:6379/0
# -- Native only --
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# ---- 3. Sign-in, admin, CORS -------------------------------------------------
# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only
# -- Native only --
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# Demo sign-in: any email and any password signs in as a consumer (created on
# first use). Advocate and admin accounts still need their real password.
# Set false for normal credential checks.
OPEN_LOGIN=true
# When both are set, this ADMIN account is created or updated on every start.
# It can upload advocate CSVs at /advocates/import. Or run:
#   uv run python -m app.scripts.create_admin --email you@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser origins allowed to call the API: the website and the advocate portal.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Base URL used to build the links in verification and reset emails. Emails are
# written to the API log (event email_dev_send), not sent.
FRONTEND_BASE_URL=http://localhost:3000


# ---- 4. Advocate directory ---------------------------------------------------
# CSV imported (added or updated, never deleted) on every start. Relative to
# apps/api. Empty disables it.
ADVOCATES_CSV_PATH=data/advocates.csv
# The bundled file is synthetic. true labels every row "Sample" in the product.
# (Native only: Compose always uses true.)
ADVOCATES_CSV_IS_SAMPLE=true


# ---- 5. AI providers (all optional) ------------------------------------------
# Free Google AI Studio key (https://aistudio.google.com/apikey). Turns on AI
# answers and, with EMBEDDING_PROVIDER=gemini, vector search.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-flash-latest

# Free GroqCloud key (https://console.groq.com/keys). Turns on AI answers on its
# own, or backs up Gemini when both are set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# auto = the first configured of: gemini, groq, ollama, anthropic.
# Or name one: gemini | groq | ollama | anthropic.
LLM_PROVIDER=auto
# Provider to try when the first fails (quota, outage, bad key).
# auto = the other of Gemini/Groq if its key is set; none = never fall back;
# or a provider name.
LLM_FALLBACK_PROVIDER=auto

# Ollama runs a model on this computer (no key): install from https://ollama.com,
# then `ollama pull llama3.1:8b`. Host: http://localhost:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# Anthropic Claude is paid and optional.
ANTHROPIC_API_KEY=

# Requests per minute per client on chat and document requests. 0 turns it off.
AI_RATE_LIMIT_PER_MINUTE=20

# -- Native only --
# Model for the Anthropic provider (applies to Anthropic only).
LLM_MODEL=claude-sonnet-5
# When no indexed passage matches, answer from general knowledge, labelled
# "general information". false = refuse instead. AI mode only.
ALLOW_GENERAL_ANSWERS=true
# Advanced, rarely changed (defaults shown).
# LLM_MAX_TOKENS=1024
# LLM_REQUEST_TIMEOUT_SECONDS=60
# CHAT_HISTORY_LENGTH=10


# ---- 6. Embeddings -----------------------------------------------------------
# gemini = vector + keyword search (needs GEMINI_API_KEY); none = keyword only.
EMBEDDING_PROVIDER=gemini
# -- Native only --
EMBEDDING_MODEL=gemini-embedding-001
# Fixed by the pgvector column; changing it needs a migration and a re-index.
EMBEDDING_DIMENSIONS=768
# Seconds to cache query embeddings in Redis. 0 disables the cache.
EMBEDDING_CACHE_TTL_SECONDS=86400
# Ingestion limits for admin-submitted and official sources.
INGESTION_MAX_SOURCE_BYTES=26214400
INGESTION_CHUNK_MAX_CHARS=1500
INGESTION_CHUNK_OVERLAP_CHARS=200


# ---- 7. Legal library (Hugging Face) -----------------------------------------
# On start the API reads court judgments from this public dataset into the
# database, a page at a time (nothing is downloaded whole). Needs internet
# access to huggingface.co and no key. If it cannot connect the API still runs;
# the reason shows in GET /api/v1/status under knowledge_base.corpus_load.
#   Manual run : uv run python -m app.scripts.ingest_hf_dataset --inspect
LEGAL_CORPUS_AUTOLOAD=true
# Embed the loaded passages for vector search (needs GEMINI_API_KEY).
LEGAL_CORPUS_EMBED_ON_START=true
HF_DATASET_NAME=Sumitedu/indian-case-laws
# Documents to keep indexed, and rows fetched per request.
HF_MAX_DOCUMENTS=200
HF_BATCH_SIZE=20
# Optional: dataset viewer split, or one parquet/.jsonl file of the repo.
HF_DATASET_SPLIT=
HF_DATASET_FILE=
# Read token, only for gated or private datasets.
# (https://huggingface.co/settings/tokens)
HF_TOKEN=
