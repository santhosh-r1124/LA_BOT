# =============================================================================
# apps/api — backend environment (local development)
# Copy to `.env`:  cp .env.example .env
#
# Values here override / complement the repo-root .env.example. When running the
# API inside Docker Compose the root .env is injected; this file is for running
# the API directly on the host (`uv run uvicorn ...`).
# =============================================================================

APP_ENV=development
APP_NAME=legal-platform-api
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Host-side URLs (note: localhost, not the compose service names)
DATABASE_URL=postgresql+asyncpg://legal:legal_dev_password@localhost:5432/legal_platform
DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev_password@localhost:5432/legal_platform
REDIS_URL=redis://localhost:6379/0

DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-dev-only
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=http://localhost:3000

# ---- AI model provider (chat answers, classification, drafts) ---------------
# Using Google Gemini free tier exclusively (no billing account required).
# Get a free key at: https://aistudio.google.com/apikey
#
# This single Gemini key powers:
#   - Chat & document drafting (gemini-3.5-flash)
#   - Knowledge base embeddings (gemini-embedding-001)
LLM_PROVIDER=gemini

# Google AI Studio (free tier, no billing account). ONE key powers both chat
# and knowledge-base embeddings below.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash

# Requests per minute per client on AI endpoints (protects free-tier quota).
# 0 disables.
AI_RATE_LIMIT_PER_MINUTE=20

# Embeddings / knowledge base (Phase 3) — uses GEMINI_API_KEY above.
# Load official sources with: uv run python -m app.scripts.seed_corpus
EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
INGESTION_MAX_SOURCE_BYTES=26214400
INGESTION_CHUNK_MAX_CHARS=1500
INGESTION_CHUNK_OVERLAP_CHARS=200
