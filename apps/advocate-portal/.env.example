# apps/advocate-portal - advocate portal settings (OPTIONAL)
#
# Only needed when running the portal natively (pnpm dev) against an API or
# website that are NOT at the addresses below. Copy to
# apps/advocate-portal/.env.local (Windows PowerShell:
# Copy-Item .env.example .env.local; the name must not end in .txt).
# Docker Compose sets the API address itself, from API_PORT, when it builds the
# image.
#
# Only NEXT_PUBLIC_* values exist here: they are visible in the browser and are
# inlined at build time, so restart `pnpm dev` after changing them. Never put a
# key in this file. AI keys belong to the API (apps/api/.env), not the portal.

# Where the browser finds the API. The API must list the portal's own address
# (http://localhost:3001) in its CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# The public Legal Advisor website, used for the "public directory" links.
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
# development | staging | production. Validated at start; no behaviour depends
# on it yet.
NEXT_PUBLIC_APP_ENV=development
