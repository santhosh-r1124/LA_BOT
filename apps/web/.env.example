# apps/web - website settings (OPTIONAL)
#
# Only needed when running the website natively (pnpm dev) against an API that
# is NOT at http://localhost:8000. Copy to apps/web/.env.local (Windows
# PowerShell: Copy-Item .env.example .env.local; the name must not end in .txt).
# Docker Compose sets these itself, from API_PORT, when it builds the image.
#
# Only NEXT_PUBLIC_* values exist here: they are visible in the browser and are
# inlined at build time, so restart `pnpm dev` after changing them. Never put a
# key in this file. AI keys belong to the API (apps/api/.env), not the website.

# Where the browser finds the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# development | staging | production. Validated at start; no behaviour depends
# on it yet.
NEXT_PUBLIC_APP_ENV=development
