# =============================================================================
# Render Backend Environment Variables
# =============================================================================
# Use these environment variables when deploying the FastAPI backend to Render.
# Go to: Render Dashboard → Service → Environment → Add environment variable
#
# IMPORTANT: These are SECRET variables. Keep them secure!

# ---- Runtime Configuration ------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Security Secrets (GENERATE NEW VALUES) -------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=CHANGE-ME-GENERATE-NEW-SECRET-KEY
JWT_SECRET=CHANGE-ME-GENERATE-NEW-SECRET-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# ---- Database (from Render PostgreSQL service) ----------------------------
# Get these from: Render Dashboard → PostgreSQL service
# Note: Use the Internal URL for services within Render
# Format: postgresql+asyncpg://user:password@host:5432/database
DATABASE_URL=postgresql+asyncpg://legal:CHANGEME@pg-xxx.onrender.com:5432/legal_platform
DATABASE_URL_SYNC=postgresql+psycopg://legal:CHANGEME@pg-xxx.onrender.com:5432/legal_platform

# ---- Redis Cache (from Render Redis service) ------------------------------
# Get these from: Render Dashboard → Redis service
# Format: redis://:password@host:6379/0
REDIS_URL=redis://:CHANGEME@redis-xxx.onrender.com:6379/0

# ---- CORS (from Netlify frontend URLs) -----------------------------------
# Set these to your Netlify deployment URLs
# Format: https://site1.netlify.app,https://site2.netlify.app
CORS_ORIGINS=https://la-bot-web.netlify.app,https://la-bot-advocates.netlify.app
FRONTEND_BASE_URL=https://la-bot-web.netlify.app

# ---- LLM Provider Configuration ------------------------------------------
# Choose ONE: gemini | groq | ollama | anthropic
LLM_PROVIDER=gemini

# Google AI Studio (FREE) - Recommended
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_LLM_MODEL=gemini-2.0-flash

# Alternative: GroqCloud (FREE)
# Get key: https://console.groq.com/keys
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# GROQ_MODEL=mixtral-8x7b-32768

# Alternative: Anthropic Claude (PAID)
# Get key: https://console.anthropic.com
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# LLM_MODEL=claude-sonnet-5

# ---- Embeddings Configuration -------------------------------------------
# Uses the LLM provider's embedding model (Gemini by default)
EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Rate limiting for AI endpoints (requests per minute per client)
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Email Configuration (Optional for Phase 11) -------------------------
# Leave blank to use logging (development mode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@example.com
