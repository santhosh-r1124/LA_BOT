# staging environment — variable set (real values go in the platform secret store)

APP_ENV=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Supabase (staging project) — Session pooler connection string, port 5432.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Managed Redis
REDIS_URL=rediss://<user>:<password>@<host>:<port>/0

# Secrets — from the platform secret store
API_SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

CORS_ORIGINS=https://staging.web.example,https://staging.advocates.example

# Used to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=https://staging.web.example

# Model provider — see docs/api-inventory.md. Free tiers are rate-limited;
# for real traffic consider GROQ as a second provider or a paid tier.
LLM_PROVIDER=auto
GEMINI_LLM_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
AI_RATE_LIMIT_PER_MINUTE=20

# Embeddings / knowledge base — Google AI Studio, free tier.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Frontend (Vercel preview env)
# Security hardening (docs/adr/0014). The API refuses to start in production
# if JWT_SECRET is a default or shorter than 32 chars, or CORS_ORIGINS is "*".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_RATE_LIMIT_PER_MINUTE=10
# Only fetch knowledge-base sources from these hosts (SSRF defence).
INGESTION_ALLOWED_HOSTS=indiacode.nic.in,legislative.gov.in,meity.gov.in,egazette.gov.in
# Rate limits key on client IP. Behind your platform's load balancer, set
# this to the proxy's address range so uvicorn trusts X-Forwarded-For —
# otherwise every user shares one rate-limit bucket. "*" only if the
# container is reachable solely through that proxy.
FORWARDED_ALLOW_IPS=

# Email (docs/adr/0013) — any SMTP relay.
EMAIL_BACKEND=smtp
EMAIL_FROM=Legal Advisor (staging) <no-reply@staging.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Payments (docs/adr/0012) — use test-mode keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_API_BASE_URL=https://staging.api.example
NEXT_PUBLIC_APP_ENV=staging
