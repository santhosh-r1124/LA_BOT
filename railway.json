{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "cd apps/api && uv sync && uv run alembic upgrade head && uv run uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyCondition": "on-failure",
    "restartPolicyMaxRetries": 5
  },
  "plugins": [
    {
      "source": "https://github.com/railwayapp/plugins/releases/download/v1/postgres.zip"
    },
    {
      "source": "https://github.com/railwayapp/plugins/releases/download/v1/redis.zip"
    }
  ]
}
