{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "pnpm run api:dev",
    "restartPolicyCondition": "on-failure",
    "restartPolicyMaxRetries": 5
  },
  "plugins": [
    {
      "source": "https://github.com/railwayapp/plugins/releases/download/v1/postgres.zip"
    }
  ]
}
