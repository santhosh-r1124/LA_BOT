# =============================================================================
# Netlify Frontend Environment Variables
# =============================================================================
# Use these environment variables when deploying to Netlify.
# Go to: Site Settings → Build & deploy → Environment → Add environment variable
#
# IMPORTANT: These are PUBLIC variables (prefixed with NEXT_PUBLIC_).
# DO NOT put secrets here. LLM API keys go in the BACKEND (Render/Railway).

# ---- Frontend Config -------------------------------------------------------
# Backend API URL (from Render/Railway deployment)
# Example: https://la-bot-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://la-bot-api.onrender.com

# App environment
NEXT_PUBLIC_APP_ENV=production
